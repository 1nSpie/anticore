# Database
DATABASE_URL="postgresql://username:password@localhost:5432/anticore"

# Server Configuration  
PORT=4444
FRONTEND_BASE_URL="http://localhost:3000"

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"
TELEGRAM_CHAT_ID="your_chat_id_here"

# Instructions:
# 1. Create a new bot by messaging @BotFather on Telegram
# 2. Copy the bot token to TELEGRAM_BOT_TOKEN
# 3. Get your chat ID by messaging @userinfobot or using https://api.telegram.org/bot<YourBOTToken>/getUpdates
# 4. Copy the chat ID to TELEGRAM_CHAT_ID
